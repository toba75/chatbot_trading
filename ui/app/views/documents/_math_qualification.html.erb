<section id="math_qualification" class="math-qualification" aria-labelledby="math-qualification-title">
  <% if qualification.succeeded? && qualification.native_page_html.attached? %>
    <% corrected_preview = qualification.current_contract? && qualification.derived_html.attached? %>
    <span hidden
      data-controller="page-html-availability"
      data-page-html-availability-url-value="<%= corrected_preview ? derived_html_preview_document_path(qualification.conversion_attempt.document) : page_html_preview_document_path(qualification.conversion_attempt.document) %>"
      data-page-html-availability-label-value="<%= corrected_preview ? "HTML corrigé" : "HTML natif paginé" %>"
      data-page-html-availability-corrected-value="<%= corrected_preview %>"></span>
  <% end %>
  <h2 id="math-qualification-title">Qualification mathématique</h2>

  <% if qualification.queued? || qualification.running? %>
    <p><strong><%= qualification.queued? ? "En attente" : "Analyse en cours" %></strong></p>
    <%= render "documents/math_qualification_progress", qualification: qualification %>
  <% elsif qualification.failed? %>
    <div class="status-card error" role="alert">
      <div>
        <strong>La qualification mathématique a échoué</strong>
        <p><%= qualification.error_message %></p>
        <code><%= qualification.error_code %></code>
      </div>
    </div>
    <%= button_to "Relancer la qualification", retry_math_qualification_document_path(qualification.conversion_attempt.document),
      method: :post, class: "button", data: { turbo_frame: "_top" } %>
  <% else %>
    <% unless qualification.current_contract? %>
      <%= button_to "Requalifier avec l’analyseur courant", retry_math_qualification_document_path(qualification.conversion_attempt.document),
        method: :post, class: "button", data: { turbo_frame: "_top" } %>
    <% else %>
      <% if qualification.conversion_attempt.current_math_requalification_allowed? %>
        <%= button_to "Relancer l’analyse et les corrections", retry_math_qualification_document_path(qualification.conversion_attempt.document),
          method: :post, class: "button", data: { turbo_frame: "_top" } %>
      <% end %>
    <% end %>
    <p class="math-verdict"><strong>Verdict : <%= qualification.verdict %></strong></p>
    <dl class="math-summary">
      <div><dt>Régions observées</dt><dd><%= qualification.summary.fetch("regions") %></dd></div>
      <div><dt>Conformes</dt><dd><%= qualification.summary.fetch("conformant") %></dd></div>
      <div><dt>Contradictoires</dt><dd><%= qualification.summary.fetch("contradicted") %></dd></div>
      <div><dt>Non vérifiables</dt><dd><%= qualification.summary.fetch("non_verifiable") %></dd></div>
    </dl>
    <p>
      Pages prouvées : <%= qualification.summary.dig("coverage", "pages_traced") %> / <%= qualification.summary.dig("coverage", "pages_total") %>.
    </p>
    <% correction = qualification.summary["correction"] %>
    <% if correction %>
      <div class="math-correction">
        <h3>Correction mathématique dérivée</h3>
        <% case correction.fetch("status") %>
        <% when "corrected" %>
          <p><strong><%= correction.fetch("accepted") %> région(s) corrigée(s) et prouvée(s).</strong></p>
          <p>Les sorties Docling natives ci-dessus restent inchangées.</p>
          <% if qualification.derived_html.attached? %>
            <p>La vue paginée correspondante est disponible dans l’onglet « HTML corrigé ».</p>
          <% end %>
        <% when "failed" %>
          <p><strong>La proposition de correction a échoué explicitement.</strong> Aucune sortie native n’a été remplacée.</p>
        <% when "rejected" %>
          <p><strong>Aucune proposition n’était entièrement prouvée.</strong> Aucun document dérivé n’a été produit.</p>
        <% else %>
          <p>Aucune région contradictoire ne nécessitait de correction.</p>
        <% end %>
      </div>
    <% else %>
      <p>Qualification historique sans phase de correction automatique.</p>
    <% end %>
    <% if qualification.summary.fetch("region_details").any? %>
      <details>
        <summary>Régions et boîtes qualifiées</summary>
        <table class="math-regions">
          <thead><tr><th>Page</th><th>Boîte PDF</th><th>Verdict</th></tr></thead>
          <tbody>
            <% qualification.summary.fetch("region_details").each do |region| %>
              <tr>
                <td><%= region.fetch("page") %></td>
                <td><code><%= region.fetch("source_bbox", region["bbox"]).join(", ") %></code></td>
                <td><%= region.fetch("verdict") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </details>
    <% end %>
    <% if qualification.summary.fetch("page_exclusions").any? %>
      <details>
        <summary>Pages ou zones non prouvées</summary>
        <ul>
          <% qualification.summary.fetch("page_exclusions").each do |page| %>
            <li>
              Page <%= page.fetch("page") %> — <%= page.fetch("status") %> :
              <%= page.fetch("reasons").map { |reason| reason.fetch("message") }.join(" ; ") %>
              <% if page.fetch("regions", []).any? %>
                <ul>
                  <% page.fetch("regions").each do |region| %>
                    <li>
                      <%= region.fetch("resource") %> —
                      [<%= region.fetch("bbox").map { |value| value.round(1) }.join(", ") %>]
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </details>
    <% end %>
  <% end %>

  <%= render "documents/math_qualification_artifacts", qualification: qualification %>
</section>
