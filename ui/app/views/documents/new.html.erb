<main class="page-shell upload-page">
  <header class="page-heading">
    <p class="eyebrow">Nouvelle conversion</p>
    <h1>Importer des documents PDF</h1>
    <p class="lead">Sélectionnez un ou plusieurs fichiers à traiter dans la même opération.</p>
  </header>

  <div class="upload-workspace">
    <section class="upload-panel" aria-labelledby="upload-panel-title">
      <div class="panel-heading">
        <p class="panel-index">01</p>
        <div>
          <h2 id="upload-panel-title">Documents sources</h2>
          <p>Format PDF · Plusieurs fichiers acceptés</p>
        </div>
      </div>

      <% if @upload_error %>
        <p class="form-error" role="alert"><%= @upload_error %></p>
      <% end %>

      <%= form_with url: documents_path, scope: :document, class: "upload-form" do |form| %>
        <%= form.label :source_pdfs, "Documents PDF", class: "sr-only" %>
        <%= form.file_field :source_pdfs, accept: "application/pdf,.pdf", multiple: true, required: true %>
        <div class="form-actions">
          <%= form.submit "Lancer les conversions", class: "button" %>
          <%= link_to "Voir les documents", documents_path, class: "text-link" %>
        </div>
      <% end %>
    </section>

    <aside class="runtime-panel" aria-labelledby="runtime-panel-title">
      <p class="eyebrow">Conservation</p>
      <h2 id="runtime-panel-title">Sorties documentaires</h2>
      <dl class="runtime-list">
        <div><dt>Source</dt><dd>PDF original</dd></div>
        <div><dt>Structure</dt><dd>JSON canonique</dd></div>
        <div><dt>Lecture</dt><dd>HTML · Markdown</dd></div>
        <div><dt>Contrôle</dt><dd>Comparaison par page</dd></div>
      </dl>
    </aside>
  </div>
</main>
