<main
  class="document-page"
  data-controller="cable-reconcile"
  data-cable-reconcile-url-value="<%= document_path(@document) %>"
>
  <%= turbo_stream_from @document %>

  <%= turbo_frame_tag @document, data: { cable_reconcile_target: "frame" } do %>
    <%= link_to "Documents", documents_path, class: "back-link", data: { turbo_frame: "_top" } %>

    <%= render "document_header", document: @document %>

    <p class="elapsed-time">
      Durée écoulée depuis l’envoi :
      <%= tag.time "00:00:00", data: {
        controller: "elapsed-time",
        elapsed_time_started_at_value: @attempt.created_at.iso8601,
        elapsed_time_ended_at_value: @attempt.completed_at&.iso8601
      } %>
    </p>

    <section class="document-panels" data-controller="panel-tabs">
      <nav class="panel-tabs" role="tablist" aria-label="Sections du document">
        <button
          id="document-metadata-tab"
          type="button"
          class="panel-tab"
          role="tab"
          aria-controls="document-metadata-panel"
          aria-selected="false"
          tabindex="-1"
          data-panel-tabs-target="tab"
          data-action="click->panel-tabs#select keydown->panel-tabs#navigate"
        >Métadonnées</button>
        <button
          id="document-visualization-tab"
          type="button"
          class="panel-tab active"
          role="tab"
          aria-controls="document-visualization-panel"
          aria-selected="true"
          tabindex="0"
          data-panel-tabs-target="tab"
          data-action="click->panel-tabs#select keydown->panel-tabs#navigate"
        >Visualisation</button>
      </nav>

      <div
        id="document-metadata-panel"
        role="tabpanel"
        aria-labelledby="document-metadata-tab"
        hidden
        data-panel-tabs-target="panel"
      >
        <%= render "document_metadata", document: @document, attempt: @attempt %>
      </div>

      <div
        id="document-visualization-panel"
        role="tabpanel"
        aria-labelledby="document-visualization-tab"
        data-panel-tabs-target="panel"
      >
        <% if @attempt.staging? || @attempt.queued? || @attempt.converting? %>
          <% status = @document.processing_status %>
          <section class="status-card" aria-live="polite">
            <span class="status-dot"></span>
            <div>
              <strong><%= status.fetch(:label) %></strong>
              <p>La page se mettra à jour dès que l’état persistant changera.</p>
            </div>
          </section>
        <% elsif @attempt.failed? %>
          <section class="status-card error" role="alert">
            <div>
              <strong>La conversion a échoué</strong>
              <p><%= @attempt.error_message %></p>
              <code><%= @attempt.error_code %></code>
            </div>
          </section>
          <%= render "attempt_outputs", attempt: @attempt, title: "Sorties conservées" %>
          <%= button_to "Relancer le traitement", retry_document_path(@document), method: :post,
            class: "button", data: { turbo_frame: "_top" } %>
        <% else %>
          <% blank_pages = @attempt.page_inventory.select { |page| page[:blank] }.pluck(:number) %>
          <% if blank_pages.any? %>
            <% page_links = blank_pages.map do |page| %>
              <% link_to page, "#document-visualization-panel",
                aria: { label: "Afficher la page #{page} dans le PDF" },
                data: {
                  action: "blank-page-navigation#show",
                  blank_page_navigation_page_param: page
                } %>
            <% end %>
            <p class="conversion-warning" role="alert" data-controller="blank-page-navigation">
              <strong><%= blank_pages.one? ? "1 page semble vide" : "#{blank_pages.size} pages semblent vides" %></strong>
              — <%= blank_pages.one? ? "page" : "pages" %> <%= safe_join(page_links, ", ") %>
            </p>
          <% end %>

          <% if @math_qualification %>
            <%= render "math_qualification", qualification: @math_qualification %>
          <% end %>

          <% if @previous_math_qualifications.any? %>
            <details class="math-qualification-history">
              <summary>Historique des qualifications mathématiques</summary>
              <% @previous_math_qualifications.each do |qualification| %>
                <article>
                  <h3>Qualification #<%= qualification.id %> du <%= l qualification.created_at, format: :long %> — <%= qualification.failed? ? "échec" : "réussie" %></h3>
                  <% if qualification.failed? %>
                    <p>
                      La qualification a échoué.
                      <%= tag.code qualification.error_code if qualification.error_code.present? %>
                    </p>
                  <% end %>
                  <%= render "math_qualification_artifacts", qualification: qualification %>
                </article>
              <% end %>
            </details>
          <% end %>

          <%= render "document_visualization" %>

          <p class="notice">L’HTML et le Markdown suivent l’ordre de lecture ; le PDF reste la référence pour la géométrie et la mise en page.</p>
        <% end %>
      </div>
    </section>

    <% if @previous_attempts.any? %>
      <details class="attempt-history">
        <summary>Historique des tentatives</summary>
        <% @previous_attempts.each do |attempt| %>
          <article>
            <h2>Tentative du <%= l attempt.created_at, format: :long %> — <%= attempt.status %></h2>
            <% if attempt.failed? %>
              <p><%= attempt.error_message %> <code><%= attempt.error_code %></code></p>
            <% end %>
            <%= render "attempt_outputs", attempt: attempt, title: nil %>
          </article>
        <% end %>
      </details>
    <% end %>
  <% end %>
</main>
