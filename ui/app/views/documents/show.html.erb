<main
  class="document-page"
  data-controller="cable-reconcile"
  data-cable-reconcile-url-value="<%= document_path(@document) %>"
>
  <%= turbo_stream_from @document %>

  <%= turbo_frame_tag @document, data: { cable_reconcile_target: "frame" } do %>
    <header class="document-header">
      <div>
        <p class="eyebrow">Conversion Docling</p>
        <h1><%= @document.source_pdf.filename %></h1>
      </div>
      <%= link_to "Nouveau document", root_path, class: "button secondary", data: { turbo_frame: "_top" } %>
    </header>

    <p class="elapsed-time">
      Durée écoulée depuis l’envoi :
      <%= tag.time "00:00:00", data: {
        controller: "elapsed-time",
        elapsed_time_started_at_value: @attempt.created_at.iso8601,
        elapsed_time_ended_at_value: @attempt.completed_at&.iso8601
      } %>
    </p>

    <% if @attempt.queued? || @attempt.converting? %>
      <section class="status-card" aria-live="polite">
        <span class="status-dot"></span>
        <div>
          <strong><%= @attempt.queued? ? "En attente" : "Conversion en cours" %></strong>
          <p>La page se mettra à jour dès que l’état persistant changera.</p>
        </div>
      </section>
    <% elsif @attempt.failed? %>
      <section class="status-card error" role="alert">
        <div>
          <strong>La conversion a échoué</strong>
          <p><%= @attempt.error_message %></p>
          <code><%= @attempt.error_code %></code>
        </div>
      </section>
      <%= render "attempt_outputs", attempt: @attempt, title: "Sorties conservées" %>
      <%= button_to "Relancer le traitement", retry_document_path(@document), method: :post,
        class: "button", data: { turbo_frame: "_top" } %>
    <% else %>
      <section class="quality-summary" aria-label="Résumé de la conversion">
        <p><strong><%= @attempt.page_count %> pages</strong>, dont <%= @attempt.page_inventory.count { |page| page[:blank] } %> vide</p>
        <p><strong><%= @attempt.picture_count %> images</strong> — pages <%= @attempt.picture_pages.to_sentence(two_words_connector: " et ", last_word_connector: " et ") %></p>
      </section>

      <% if @math_qualification %>
        <%= render "math_qualification", qualification: @math_qualification %>
      <% end %>

      <% if @previous_math_qualifications.any? %>
        <details class="math-qualification-history">
          <summary>Historique des qualifications mathématiques</summary>
          <% @previous_math_qualifications.each do |qualification| %>
            <article>
              <h3>Qualification du <%= l qualification.created_at, format: :long %> — <%= qualification.failed? ? "échec" : "réussie" %></h3>
              <% if qualification.failed? %>
                <p>
                  La qualification a échoué.
                  <%= tag.code qualification.error_code if qualification.error_code.present? %>
                </p>
              <% end %>
              <%= render "math_qualification_artifacts", qualification: qualification %>
            </article>
          <% end %>
        </details>
      <% end %>

      <% native_page_html_available = !!(@math_qualification&.succeeded? && @math_qualification.native_page_html.attached?) %>
      <% corrected_html_available = !!(
        @math_qualification&.succeeded? && @math_qualification.current_contract? &&
        @math_qualification.derived_html.attached?
      ) %>
      <% html_formats = [
        [ "HTML corrigé", "html-corrected", derived_html_preview_document_path(@document), "HTML corrigé", true, :html, corrected_html_available ],
        [ "HTML natif paginé", "html-native-page", page_html_preview_document_path(@document), "HTML natif paginé", true, :html, native_page_html_available ],
        [ "HTML natif exact", "html-native-exact", html_preview_document_path(@document), "HTML natif exact", false, :html, true ]
      ] %>
      <% formats = html_formats + [
        [ "Markdown", "markdown", markdown_preview_document_path(@document), "Conversion Markdown", false, :markdown, true ],
        [ "JSON", "json", docling_page_preview_document_path(@document, page: 1), "Projection JSON de la page 1", false, :json, true ]
      ] %>
      <% initial_format = if corrected_html_available
        formats.first
      elsif native_page_html_available
        formats.second
      else
        formats.third
      end %>
      <% initial_html_path = initial_format[4] ? "#{initial_format[2]}#page-1" : initial_format[2] %>
      <% initial_html_title = initial_format[4] ? "#{initial_format[3]} — page 1" : initial_format[3] %>
      <section
        class="comparison"
        aria-label="Comparaison du document"
        data-controller="page-sync"
        data-action="page-html:available@window->page-sync#useHtmlUrl"
        data-page-sync-pdf-url-value="<%= rails_blob_path(@document.source_pdf, disposition: "inline") %>"
        data-page-sync-html-url-value="<%= initial_format[2] %>"
        data-page-sync-html-synchronized-value="<%= initial_format[4] %>"
        data-page-sync-json-url-value="<%= docling_page_preview_document_path(@document) %>"
        data-page-sync-page-count-value="<%= @attempt.page_count %>"
        data-page-sync-worker-url-value="<%= asset_path("pdfjs/pdf.worker.min.js") %>"
      >
        <article>
          <h2>PDF original</h2>
          <nav class="page-navigation" aria-label="Navigation dans le PDF original">
            <button type="button" data-page-sync-target="previous" data-action="page-sync#previous" disabled>Précédente</button>
            <label>
              Page
              <input
                type="number"
                min="1"
                value="1"
                inputmode="numeric"
                data-page-sync-target="page"
                data-action="change->page-sync#choosePage keydown.enter->page-sync#choosePage"
              >
              / <span data-page-sync-target="total"><%= @attempt.page_count %></span>
            </label>
            <button type="button" data-page-sync-target="next" data-action="page-sync#next">Suivante</button>
          </nav>
          <div class="pdf-page-viewer" data-page-sync-target="viewer">
            <p data-page-sync-target="status">Chargement du PDF…</p>
            <canvas title="Page courante du PDF original" data-page-sync-target="canvas"></canvas>
          </div>
        </article>
        <article data-controller="format-tabs">
          <h2>Conversion Docling</h2>
          <% preview_id = "docling-preview-#{@document.id}" %>
          <% preview_name = "docling_preview_#{@document.id}" %>
          <nav class="format-tabs" role="tablist" aria-label="Formats Docling">
            <% formats.each do |label, key, path, title, synchronized, kind, available| %>
              <% tab_id = "#{preview_id}-#{key}" %>
              <% selected = key == initial_format[1] %>
              <%= link_to label, path,
                id: tab_id,
                class: class_names("format-tab", active: selected),
                role: "tab",
                target: preview_name,
                hidden: !available,
                tabindex: selected ? 0 : -1,
                aria: { controls: preview_id, selected: selected },
                data: {
                  format_tabs_target: "tab",
                  page_sync_target: if key == "html-corrected"
                    "htmlTab correctedHtmlTab"
                  elsif key == "html-native-page"
                    "htmlTab nativeHtmlTab"
                  elsif kind == :html
                    "htmlTab"
                  elsif kind == :json
                    "jsonTab"
                  end,
                  page_sync_base_url: kind == :html ? path : nil,
                  page_sync_synchronized: kind == :html ? synchronized : nil,
                  page_sync_title: kind == :html ? title : nil,
                  action: class_names(
                    "click->format-tabs#select keydown->format-tabs#navigate",
                    "click->page-sync#selectHtml" => kind == :html,
                    "click->page-sync#selectJson" => kind == :json
                  ),
                  preview_title: title
                } %>
            <% end %>
          </nav>
          <p class="html-sync-notice" data-page-sync-target="htmlSyncNotice" <%= "hidden" if native_page_html_available %>>
            La synchronisation HTML par page sera disponible après une qualification mathématique réussie.
          </p>
          <iframe
            id="<%= preview_id %>"
            name="<%= preview_name %>"
            title="<%= initial_html_title %>"
            role="tabpanel"
            aria-labelledby="<%= preview_id %>-<%= initial_format[1] %>"
            sandbox=""
            data-format-tabs-target="preview"
            data-page-sync-target="doclingPreview"
            src="<%= initial_html_path %>"></iframe>
          <p class="canonical-download">
            <%= link_to "Télécharger le JSON canonique complet",
              rails_blob_path(@attempt.docling_document, disposition: "attachment") %>
          </p>
        </article>
      </section>

      <p class="notice">L’HTML et le Markdown suivent l’ordre de lecture ; le PDF reste la référence pour la géométrie et la mise en page.</p>

      <section class="page-details">
        <article>
          <h2>Pages canoniques</h2>
          <ol class="page-list">
            <% @attempt.page_inventory.each do |page| %>
              <li>Page <%= page[:number] %><%= " — vide" if page[:blank] %></li>
            <% end %>
          </ol>
        </article>
      </section>
    <% end %>

    <% if @previous_attempts.any? %>
      <details class="attempt-history">
        <summary>Historique des tentatives</summary>
        <% @previous_attempts.each do |attempt| %>
          <article>
            <h2>Tentative du <%= l attempt.created_at, format: :long %> — <%= attempt.status %></h2>
            <% if attempt.failed? %>
              <p><%= attempt.error_message %> <code><%= attempt.error_code %></code></p>
            <% end %>
            <%= render "attempt_outputs", attempt: attempt, title: nil %>
          </article>
        <% end %>
      </details>
    <% end %>
  <% end %>
</main>
