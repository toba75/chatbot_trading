<main
  class="documents-index"
  data-controller="cable-reconcile"
  data-cable-reconcile-url-value="<%= documents_path %>"
>
  <%= turbo_stream_from "documents" %>

  <%= turbo_frame_tag "documents_index", target: "_top", data: { cable_reconcile_target: "frame" } do %>
    <header class="page-heading page-heading--split">
      <div>
        <p class="eyebrow">Bibliothèque</p>
        <h1>Documents</h1>
        <p class="lead"><%= pluralize(@documents.size, "document", plural: "documents") %> dans l’espace de travail</p>
      </div>
      <%= link_to "Nouveau document", root_path, class: "button" %>
    </header>

    <section class="documents-panel" aria-label="Documents traités">
      <% if @documents.empty? %>
        <div class="empty-state">
          <p class="empty-state__mark" aria-hidden="true">PDF</p>
          <h2>Aucun document</h2>
          <p>Les prochains fichiers importés apparaîtront ici.</p>
        </div>
      <% else %>
        <div class="document-list-header" aria-hidden="true">
          <span>Document</span>
          <span>Statut</span>
          <span>Ajouté le</span>
          <span></span>
        </div>
        <ol class="document-list">
          <% @documents.each do |document| %>
            <% status = document.processing_status %>
            <%= turbo_stream_from document if document.processing_status_transient? %>
            <li>
              <%= link_to document_path(document), class: "document-link" do %>
                <span class="document-identity">
                  <strong><%= document.source_pdf.filename %></strong>
                  <small>Document <%= document.id %></small>
                </span>
                <span class="status-badge status-badge--<%= status.fetch(:key) %>"><%= status.fetch(:label) %></span>
                <time datetime="<%= document.created_at.iso8601 %>"><%= document.created_at.strftime("%d/%m/%Y %H:%M") %></time>
                <span class="document-open">Consulter</span>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  <% end %>
</main>
